@page "/cart"
@using EShop.Shared.Models
@using EShop.Web.Services
@inject CartApiClient CartApiClient
@inject CartSessionService CartSessionService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Shopping Cart</PageTitle>

<h1>Shopping Cart</h1>

@if (cart is null)
{
    <p>Loading your cart...</p>
}
else if (cart.Items.Count == 0)
{
    <div class="alert alert-info">Your cart is empty.</div>
    <a class="btn btn-primary" href="/products">Browse Products</a>
}
else
{
    <div class="list-group mb-4">
        @foreach (var item in cart.Items)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-1">@item.ProductName</h5>
                    <div>@item.Quantity x @item.UnitPrice.ToString("C")</div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <strong>@item.LineTotal.ToString("C")</strong>
                    <button class="btn btn-outline-danger btn-sm" @onclick="() => RemoveItem(item.ProductId)">Remove</button>
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Total</h4>
        <h4>@cart.Total.ToString("C")</h4>
    </div>

    <button class="btn btn-success" @onclick="GoToCheckout">Proceed to Checkout</button>
}

@code {
    private ShoppingCart? cart;

    protected override async Task OnInitializedAsync()
    {
        await LoadCartAsync();
    }

    private async Task LoadCartAsync()
    {
        string cartId = CartSessionService.GetCartId();
        cart = await CartApiClient.GetCartAsync(cartId);
    }

    private async Task RemoveItem(Guid productId)
    {
        string cartId = CartSessionService.GetCartId();
        await CartApiClient.RemoveItemAsync(cartId, productId);
        await LoadCartAsync();
    }

    private void GoToCheckout()
    {
        Navigation.NavigateTo("/checkout");
    }
}
