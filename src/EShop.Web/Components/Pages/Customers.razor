@page "/customers"
@using EShop.Shared.Models
@using EShop.Web.Services
@inject CustomerApiClient CustomerApiClient
@rendermode InteractiveServer

<PageTitle>Customers</PageTitle>

<h1>Customers</h1>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">@(_editingCustomerId.HasValue ? "Edit Customer" : "Add Customer")</h2>

                <EditForm Model="_customerForm" OnSubmit="HandleSubmitAsync">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label" for="customer-name">Name</label>
                        <InputText id="customer-name" class="form-control" @bind-Value="_customerForm.Name" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="customer-email">Email</label>
                        <InputText id="customer-email" class="form-control" @bind-Value="_customerForm.Email" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="customer-phone">Phone</label>
                        <InputText id="customer-phone" class="form-control" @bind-Value="_customerForm.Phone" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="customer-address">Address</label>
                        <InputTextArea id="customer-address" class="form-control" @bind-Value="_customerForm.Address" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">@(_editingCustomerId.HasValue ? "Update" : "Create")</button>
                        @if (_editingCustomerId.HasValue)
                        {
                            <button type="button" class="btn btn-secondary" @onclick="ResetForm">Cancel</button>
                        }
                    </div>
                </EditForm>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        @if (_items is null)
        {
            <p><em>Loading customers...</em></p>
        }
        else
        {
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Address</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Customer customer in _items)
                    {
                        <tr>
                            <td>@customer.Name</td>
                            <td>@customer.Email</td>
                            <td>@customer.Phone</td>
                            <td>@customer.Address</td>
                            <td class="text-end">
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => EditCustomer(customer)">Edit</button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCustomerAsync(customer.Id)">Delete</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private IReadOnlyList<Customer>? _items;
    private Customer _customerForm = new();
    private Guid? _editingCustomerId;

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomersAsync();
    }

    private async Task LoadCustomersAsync()
    {
        _items = await CustomerApiClient.GetAllAsync();
    }

    private void ResetForm()
    {
        _customerForm = new Customer();
        _editingCustomerId = null;
    }

    private void EditCustomer(Customer customer)
    {
        _customerForm = new Customer
        {
            Id = customer.Id,
            Name = customer.Name,
            Email = customer.Email,
            Phone = customer.Phone,
            Address = customer.Address
        };
        _editingCustomerId = customer.Id;
    }

    private async Task HandleSubmitAsync()
    {
        if (_editingCustomerId.HasValue)
        {
            await CustomerApiClient.UpdateAsync(_editingCustomerId.Value, _customerForm);
        }
        else
        {
            await CustomerApiClient.CreateAsync(_customerForm);
        }

        ResetForm();
        await LoadCustomersAsync();
    }

    private async Task DeleteCustomerAsync(Guid id)
    {
        await CustomerApiClient.DeleteAsync(id);

        if (_editingCustomerId == id)
        {
            ResetForm();
        }

        await LoadCustomersAsync();
    }
}
